{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echosentinel.local/schemas/audio-evaluation-manifest-v1.json",
  "title": "EchoSentinel audio evaluation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "samples"],
  "properties": {
    "schema_version": { "const": 1 },
    "samples": {
      "type": "array",
      "items": { "$ref": "#/$defs/sample" }
    }
  },
  "$defs": {
    "unknownableString": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id", "audio_path", "ground_truth", "source_type", "speaker_id",
        "source_recording_id", "synthetic_generator", "synthetic_generator_version",
        "language", "codec", "sample_rate", "recording_conditions", "dataset_source",
        "provenance", "consent_status", "partition", "notes", "uncertainty"
      ],
      "properties": {
        "sample_id": { "type": "string", "minLength": 1 },
        "audio_path": { "type": "string", "minLength": 1, "description": "Relative to the explicitly supplied dataset root." },
        "ground_truth": { "enum": ["bonafide", "spoof"] },
        "source_type": { "enum": ["human_recording", "synthetic_speech", "unknown"] },
        "speaker_id": { "$ref": "#/$defs/unknownableString" },
        "source_recording_id": { "$ref": "#/$defs/unknownableString" },
        "synthetic_generator": { "$ref": "#/$defs/unknownableString" },
        "synthetic_generator_version": { "$ref": "#/$defs/unknownableString" },
        "language": { "$ref": "#/$defs/unknownableString" },
        "codec": { "$ref": "#/$defs/unknownableString" },
        "sample_rate": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "recording_conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "dataset_source": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 },
        "consent_status": { "type": "string", "minLength": 1 },
        "partition": { "enum": ["development", "validation", "test"] },
        "notes": { "type": "string" },
        "uncertainty": { "type": "string" }
      }
    }
  }
}
